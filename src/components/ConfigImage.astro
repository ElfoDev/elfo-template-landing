---
/**
 * Imagem vinda da config:
 * - `~/assets/foto.jpg` (arquivo em `src/assets/`): otimizada pelo `astro:assets`
 *   (AVIF/WebP, vários tamanhos, `srcset`/`sizes`);
 * - `/foto.jpg` (em `public/`) ou URL: `<img>` comum, com lazy loading.
 */

import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  alt: string;
  /** Larguras geradas para o `srcset` (imagens de `src/assets/`). */
  widths: number[];
  sizes: string;
  /** Imagem acima da dobra: carrega já, com prioridade. */
  priority?: boolean;
  width?: number;
  height?: number;
  class?: string;
}

const {
  src,
  alt,
  widths,
  sizes,
  priority = false,
  width,
  height,
  class: className,
} = Astro.props;

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
);

let local: ImageMetadata | undefined;
if (src.startsWith("~/")) {
  const load = assets[`/src/${src.slice(2)}`];
  if (!load) throw new Error(`Imagem não encontrada: ${src} (esperada em src/${src.slice(2)})`);
  local = (await load()).default;
}

const loading = priority ? "eager" : "lazy";
const fetchpriority = priority ? "high" : undefined;
---

{
  local ? (
    <Picture
      src={local}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={["avif", "webp"]}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class={className}
    />
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class={className}
    />
  )
}
