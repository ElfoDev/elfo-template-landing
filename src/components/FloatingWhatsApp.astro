---
/**
 * Botão flutuante de WhatsApp (CTA `floating`). Aparece depois que o CTA do
 * hero sai da tela e some perto do CTA final; a lógica está em
 * `src/lib/floating.ts` e `src/scripts/landing.ts`.
 */
import { ctaHref, siteConfig } from "../lib/config";
import Icon from "./Icon.astro";

const floating = siteConfig.sections.floating.enabled ? siteConfig.sections.floating : undefined;
const label = floating?.label ?? siteConfig.whatsapp.ctaLabel;
---

{
  floating && (
    <a
      href={ctaHref("floating")}
      target="_blank"
      rel="noopener noreferrer"
      data-whatsapp-cta="floating"
      data-floating-cta
      aria-label={label}
      class="floating-cta group fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-40 grid size-14 place-items-center rounded-full bg-primary text-primary-foreground shadow-[0_12px_30px_-8px_color-mix(in_oklab,var(--color-primary)_70%,transparent),0_2px_6px_rgb(0_0_0/0.15)] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-text sm:right-6 sm:bottom-6 sm:size-15"
    >
      <Icon name="whatsapp" class="size-7" />
      <span
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 right-[calc(100%+0.75rem)] hidden translate-x-2 -translate-y-1/2 rounded-full bg-text px-3.5 py-2 text-sm font-semibold whitespace-nowrap text-background opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 sm:block"
      >
        {label}
      </span>
    </a>
  )
}
