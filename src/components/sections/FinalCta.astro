---
import { SECTION_ANCHORS, siteConfig } from "../../lib/config";
import Icon from "../Icon.astro";
import WhatsAppButton from "../WhatsAppButton.astro";

const finalCta = siteConfig.sections.finalCta.enabled ? siteConfig.sections.finalCta : undefined;
const id = SECTION_ANCHORS.finalCta;
---

{
  finalCta && (
    <section id={id} aria-labelledby={`${id}-title`} class="px-4 pt-8 pb-18 sm:px-6 lg:pb-26">
      <div
        data-reveal
        data-final-cta
        class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-primary px-5 py-14 text-center text-primary-foreground sm:px-12 sm:py-18 lg:px-16 lg:py-22"
      >
        <div
          aria-hidden="true"
          class="absolute -top-64 -right-56 -z-10 size-128 rounded-full bg-[radial-gradient(color-mix(in_oklab,var(--color-accent)_35%,transparent),transparent_65%)]"
        />
        <svg
          aria-hidden="true"
          viewBox="0 0 1000 320"
          preserveAspectRatio="xMidYMax slice"
          class="absolute inset-x-0 bottom-0 -z-10 h-3/4 w-full fill-none stroke-current stroke-2 opacity-15"
        >
          {[160, 240, 320, 400, 480, 560].map((r) => (
            <circle cx="500" cy="440" r={r} />
          ))}
        </svg>
        <h2
          id={`${id}-title`}
          class="mx-auto max-w-2xl text-[clamp(2rem,1.5rem+2.4vw,3.25rem)] leading-tight font-extrabold tracking-[-0.03em]"
        >
          {finalCta.title}
        </h2>
        {finalCta.subtitle && (
          <p class="mx-auto mt-4 max-w-xl text-lg opacity-95">{finalCta.subtitle}</p>
        )}
        <div class="mt-8">
          <WhatsAppButton cta="finalCta" label={finalCta.ctaLabel} size="lg" variant="inverted" />
        </div>
        {finalCta.note && (
          <p class="mt-5 flex flex-wrap items-center justify-center gap-2 text-sm opacity-95">
            <Icon name="clock" class="size-4" />
            {finalCta.note}
          </p>
        )}
      </div>
    </section>
  )
}
