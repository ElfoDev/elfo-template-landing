---
import { siteConfig } from "../../lib/config";
import Section from "../Section.astro";

const { benefits } = siteConfig.sections;
---

{
  benefits.enabled && (
    <Section id="beneficios" title={benefits.title} subtitle={benefits.subtitle}>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {benefits.items.map((item) => (
          <li class="rounded-2xl border border-text/10 bg-white/60 p-6">
            {item.icon && (
              <span aria-hidden="true" class="text-3xl">
                {item.icon}
              </span>
            )}
            <h3 class="mt-3 text-xl font-semibold">{item.title}</h3>
            <p class="mt-2 text-text/75">{item.description}</p>
          </li>
        ))}
      </ul>
    </Section>
  )
}
