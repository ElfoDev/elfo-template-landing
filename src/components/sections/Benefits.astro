---
import { SECTION_ANCHORS, siteConfig } from "../../lib/config";
import { isIconName } from "../../lib/icons";
import Icon from "../Icon.astro";
import Section from "../Section.astro";

const benefits = siteConfig.sections.benefits.enabled ? siteConfig.sections.benefits : undefined;
---

{
  benefits && (
    <Section
      id={SECTION_ANCHORS.benefits}
      kicker={benefits.kicker}
      title={benefits.title}
      subtitle={benefits.subtitle}
    >
      <ul class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6">
        {benefits.items.map((item, index) => (
          <li data-reveal style={`--reveal-delay:${index * 0.06}s`}>
            <article class="group h-full rounded-[1.25rem] border border-text/10 bg-surface p-6 transition duration-300 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-soft sm:p-7">
              {item.icon && (
                <div
                  aria-hidden="true"
                  class="grid size-11 place-items-center rounded-[0.875rem] bg-primary/12 text-primary transition-transform duration-300 group-hover:scale-105 group-hover:-rotate-6"
                >
                  {isIconName(item.icon) ? (
                    <Icon name={item.icon} />
                  ) : (
                    <span class="text-2xl">{item.icon}</span>
                  )}
                </div>
              )}
              <h3 class="mt-4.5 text-lg font-bold">{item.title}</h3>
              <p class="mt-2 text-text/75">{item.description}</p>
            </article>
          </li>
        ))}
      </ul>
    </Section>
  )
}
