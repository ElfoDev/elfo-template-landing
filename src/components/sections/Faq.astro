---
import { siteConfig } from "../../lib/config";
import Section from "../Section.astro";

const { faq } = siteConfig.sections;
---

{
  faq.enabled && (
    <Section id="faq" title={faq.title} subtitle={faq.subtitle}>
      <div class="mx-auto max-w-3xl divide-y divide-text/10 rounded-2xl border border-text/10">
        {faq.items.map((item) => (
          <details class="group p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {item.question}
              <span aria-hidden="true" class="text-xl transition group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 text-text/75">{item.answer}</p>
          </details>
        ))}
      </div>
    </Section>
  )
}
