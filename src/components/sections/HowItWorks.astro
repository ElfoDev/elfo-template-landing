---
import { siteConfig } from "../../lib/config";
import Section from "../Section.astro";

const { howItWorks } = siteConfig.sections;
---

{
  howItWorks.enabled && (
    <Section id="como-funciona" title={howItWorks.title} subtitle={howItWorks.subtitle}>
      <ol class="grid gap-6 md:grid-cols-3">
        {howItWorks.steps.map((step, index) => (
          <li class="rounded-2xl border border-text/10 p-6">
            <span class="flex size-10 items-center justify-center rounded-full bg-primary font-bold text-primary-foreground">
              {index + 1}
            </span>
            <h3 class="mt-4 text-xl font-semibold">{step.title}</h3>
            <p class="mt-2 text-text/75">{step.description}</p>
          </li>
        ))}
      </ol>
    </Section>
  )
}
