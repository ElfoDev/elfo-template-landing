---
import { navItems, siteConfig } from "../lib/config";
import Logo from "./Logo.astro";
import WhatsAppButton from "./WhatsAppButton.astro";

const items = navItems();
---

<header
  data-site-header
  class="sticky top-0 z-30 border-b border-transparent bg-background/85 backdrop-blur-md backdrop-saturate-150 transition-[border-color,box-shadow] duration-300 data-[scrolled=true]:border-text/10 data-[scrolled=true]:shadow-[0_8px_24px_-20px_rgb(0_0_0/0.5)]"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="#conteudo" class="flex min-w-0 items-center rounded-lg">
      <Logo />
    </a>
    {
      items.length > 0 && (
        <nav aria-label={siteConfig.labels.navigation} class="hidden gap-0.5 lg:flex">
          {items.map((item) => (
            <a
              href={item.href}
              class="rounded-full px-3 py-2 text-[0.9375rem] font-medium text-text/75 transition-colors hover:bg-text/10 hover:text-text"
            >
              {item.label}
            </a>
          ))}
        </nav>
      )
    }
    <WhatsAppButton cta="header" compact class="shrink-0 whitespace-nowrap" />
  </div>
</header>
