---
/** Moldura comum das seções: espaçamento, largura máxima, título e subtítulo. */
interface Props {
  id: string;
  title: string;
  subtitle?: string | undefined;
  class?: string;
}

const { id, title, subtitle, class: className } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={["px-4 py-16 sm:px-6 sm:py-24", className]}>
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id={`${id}-title`} class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
      {subtitle && <p class="mt-4 text-lg text-text/75">{subtitle}</p>}
    </div>
    <div class="mt-12">
      <slot />
    </div>
  </div>
</section>
