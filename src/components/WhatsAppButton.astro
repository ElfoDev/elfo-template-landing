---
/**
 * Botão de CTA para o WhatsApp. O link e a mensagem saem do site.config.ts
 * (`whatsapp.ctaMessages[cta]` ou `whatsapp.defaultMessage`).
 */
import { type CtaId, ctaHref, siteConfig } from "../lib/config";
import Icon from "./Icon.astro";

interface Props {
  /** Qual CTA é este (define a mensagem e aparece nos eventos de analytics). */
  cta: CtaId;
  label?: string | undefined;
  /** Mensagem própria (ex.: a de um plano); padrão: a mensagem do CTA. */
  message?: string | undefined;
  /** Nome do plano, para analytics (`data-plan`). */
  plan?: string | undefined;
  size?: "md" | "lg";
  /**
   * `primary`: cor da marca. `inverted`: sobre fundo na cor primária.
   * `outline`: contorno. `link`: link de texto, sem cara de botão.
   */
  variant?: "primary" | "inverted" | "outline" | "link";
  /** Só o ícone em telas pequenas (o texto continua para leitores de tela). */
  compact?: boolean;
  /** Mostra o ícone do WhatsApp. */
  icon?: boolean;
  class?: string;
}

const {
  cta,
  label = siteConfig.whatsapp.ctaLabel,
  message,
  plan,
  size = "md",
  variant = "primary",
  compact = false,
  icon = true,
  class: className,
} = Astro.props;

const button = variant !== "link";
---

<a
  href={ctaHref(cta, siteConfig, message)}
  target="_blank"
  rel="noopener noreferrer"
  data-whatsapp-cta={cta}
  data-plan={plan}
  class:list={[
    button &&
      "inline-flex max-w-full items-center justify-center gap-2 rounded-full text-center leading-tight font-semibold transition duration-200 hover:-translate-y-px active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2",
    variant === "primary" &&
      "bg-primary text-primary-foreground shadow-[0_1px_2px_rgb(0_0_0/0.08),0_10px_24px_-10px_color-mix(in_oklab,var(--color-primary)_70%,transparent)] hover:brightness-110 focus-visible:outline-primary",
    variant === "inverted" &&
      "bg-primary-foreground text-primary shadow-[0_12px_30px_-12px_rgb(0_0_0/0.45)] hover:brightness-105 focus-visible:outline-primary-foreground",
    variant === "outline" &&
      "text-primary ring-[1.5px] ring-primary/50 ring-inset hover:bg-primary/10 focus-visible:outline-primary",
    variant === "link" &&
      "underline decoration-text/20 underline-offset-3 transition-colors hover:text-primary hover:decoration-current",
    button && (size === "lg" ? "px-7 py-4 text-base sm:text-[1.0625rem]" : "px-4 py-2 text-sm"),
    compact && "max-sm:p-2.5",
    className,
  ]}
>
  {icon && <Icon name="whatsapp" />}
  <span class:list={[compact && "max-sm:sr-only"]}>{label}</span>
</a>
